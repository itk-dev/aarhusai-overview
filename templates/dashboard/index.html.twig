{% extends 'base.html.twig' %}

{% block title %}Dashboard — AarhusAI Overview{% endblock %}

{% block subhead %}
    <div class="subhead">
        <div class="subhead__left">
            <span class="health-cluster">
                {% for key, healthy in siteHealth %}
                    {% if healthy is null %}
                        {% set health_class = 'health--unknown' %}
                    {% elseif healthy %}
                        {% set health_class = 'health--ok' %}
                    {% else %}
                        {% set health_class = 'health--bad' %}
                    {% endif %}
                    <span class="health {{ health_class }}">
                        <span class="health__dot" aria-hidden="true"></span>
                        {{ key|capitalize }}
                    </span>
                {% endfor %}
            </span>
        </div>
        <div class="subhead__right">
            <form method="post" action="{{ path('dashboard_sync') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('sync') }}">
                <button type="submit" class="btn btn--accent">
                    {{ include('icons/sync.html.twig') }}
                    Sync now
                </button>
            </form>
        </div>
    </div>
{% endblock %}

{% block body %}
    <header class="section-head reveal reveal-3">
        <div>
            <h1 class="section-head__title">Models</h1>
        </div>
        <div class="section-head__count">
            <strong>{{ models|length }}</strong>
            {{ models|length == 1 ? 'entry' : 'entries' }}
        </div>
    </header>

    <div class="filters reveal reveal-3">
        <nav class="tabs" aria-label="Site filter">
            <a href="{{ path('dashboard', linkParams) }}" class="tab" data-sort-link{% if activeSite is null %} aria-current="true"{% endif %}>
                All sites
            </a>
            {% for key in siteKeys %}
                <a href="{{ path('dashboard', linkParams|merge({site: key})) }}" class="tab" data-sort-link{% if activeSite == key %} aria-current="true"{% endif %}>
                    {{ key|capitalize }}
                </a>
            {% endfor %}
        </nav>
        <form method="get" action="{{ path('dashboard') }}" class="search" role="search"
            data-controller="search" data-action="submit->search#prevent">
            {% if activeSite %}
                <input type="hidden" name="site" value="{{ activeSite }}">
            {% endif %}
            {% if linkParams.sort is defined %}
                <input type="hidden" name="sort" value="{{ linkParams.sort }}">
            {% endif %}
            {% if linkParams.dir is defined %}
                <input type="hidden" name="dir" value="{{ linkParams.dir }}">
            {% endif %}
            <label class="search__field">
                <span class="visually-hidden">Search by name</span>
                <input type="search" name="q" value="{{ searchQuery }}" placeholder="Search by name" autocomplete="off"
                    data-search-target="input" data-action="input->search#submit">
            </label>
        </form>
    </div>

    {{ include('dashboard/_ledger.html.twig') }}
{% endblock %}
